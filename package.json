{
  "name": "fithub",
  "private": true,
  "version": "1.0.1",
  "description": "ИИ-нутрициолог: Telegram-бот + Mini App",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter bot-api dev",
    "dev:webapp": "pnpm --filter webapp dev",
    "prisma:migrate": "pnpm --filter bot-api prisma:migrate",
    "seed": "pnpm --filter bot-api seed"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
