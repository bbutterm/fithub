# === Обязательные ===
BOT_TOKEN=            # токен Telegram-бота от BotFather
DATABASE_URL=         # Supabase → Connect → Transaction pooler (порт 6543) + ?pgbouncer=true&connection_limit=1
DIRECT_URL=           # Supabase → Connect → Direct connection (порт 5432) — для миграций Prisma
WEBAPP_URL=           # публичный URL проекта на Vercel, напр. https://nutri-ai.vercel.app

# === Опциональные ===
TZ_DEFAULT=Europe/Moscow
PORT=3000
HOST=0.0.0.0
JWT_SECRET=           # если пусто — выводится из BOT_TOKEN (sha256)
CRON_SECRET=          # Bearer-токен для /api/cron/* (Vercel задаёт автоматически, локально можно оставить пустым)
BOT_WEBHOOK_URL=      # только для self-hosted webhook-режима; на Vercel webhook ставится вручную (см. README), локально — long polling

# S3-совместимое хранилище (Supabase Storage / Cloudflare R2).
# Если S3_ENDPOINT пуст — S3 НЕ используется: храним только Telegram file_id,
# превью отдаются через backend-прокси (getFile, кэш 30 мин). Это режим по умолчанию.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# === ИИ: два независимых провайдера (смена провайдера/модели — только правка .env) ===
# Vision — фото еды (OpenRouter, Qwen)
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_API_KEY=
VISION_MODEL=qwen/qwen3-vl-32b-instruct
VISION_MODEL_FALLBACK=qwen/qwen3-vl-235b-a22b-instruct

# Text — советы, отчёты, текстовые описания еды (DeepSeek)
TEXT_BASE_URL=https://api.deepseek.com/v1
TEXT_API_KEY=
TEXT_MODEL=deepseek-chat

# === Монетизация (цены в Telegram Stars, XTR) ===
STARS_PRICE_MONTH=250     # ~299 ₽/мес
STARS_PRICE_YEAR=1700     # ~1990 ₽/год

# === Лимиты Free ===
FREE_PHOTOS_PER_DAY=3

# === Админка ===
ADMIN_TG_IDS=             # Telegram ID администраторов через запятую, напр. 123456789,987654321
USD_RUB_RATE=90           # курс для отображения расходов в рублях
# Цены токенов (USD за 1M) — используются, если провайдер не сообщает стоимость сам (OpenRouter сообщает)
PRICE_TEXT_INPUT_USD_PER_1M=0.28
PRICE_TEXT_OUTPUT_USD_PER_1M=0.42
PRICE_VISION_INPUT_USD_PER_1M=0.5
PRICE_VISION_OUTPUT_USD_PER_1M=1.5
VISION_FALLBACK_THRESHOLD=0.7   # порог уверенности для перепроверки фото fallback-моделью (0 — никогда)
