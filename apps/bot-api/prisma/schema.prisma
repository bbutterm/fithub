generator client {
  provider      = "prisma-client-js"
  // native — локальная разработка; rhel-openssl-3.0.x — serverless-функции Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase: pooled-строка (порт 6543, pgbouncer=true)
  directUrl = env("DIRECT_URL") // Supabase: прямое подключение (порт 5432) для миграций
}

model User {
  id                 Int            @id @default(autoincrement())
  tgUserId           BigInt         @unique
  firstName          String?
  username           String?
  tz                 String         @default("Europe/Moscow")
  createdAt          DateTime       @default(now())
  dailyLimitOverride Int? // персональный лимит распознаваний/день для free (админка)
  profile            Profile?
  meals              Meal[]
  advices            DailyAdvice[]
  subscriptions      Subscription[]
  usage              UsageCounter[]
  aiUsage            AiUsage[]
}

// Учёт каждого вызова ИИ: токены и стоимость (для админки)
model AiUsage {
  id               Int      @id @default(autoincrement())
  userId           Int?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  client           String // vision | text
  model            String
  purpose          String // photo | text_meal | advice | monthly | probe | json_retry
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum Gender {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  high
}

enum Goal {
  lose
  maintain
  gain
}

enum DietType {
  none
  vegetarian
  vegan
  keto
  halal
}

enum AdviceTone {
  strict
  friendly
  scientific
}

model Profile {
  userId        Int           @id
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender        Gender        @default(male)
  birthYear     Int?
  heightCm      Int?
  weightKg      Float?
  activityLevel ActivityLevel @default(moderate)
  goal          Goal          @default(maintain)
  dietType      DietType      @default(none)
  allergies     String[]      @default([])
  dislikes      String[]      @default([])
  // Лечебные и лечебно-профилактические режимы питания (идентификаторы из src/diets.ts).
  // Массив, а не enum: режимы сочетаются — «стол №5» и «средиземноморская» вместе
  // это обычное назначение, а не противоречие.
  medicalDiets  String[]      @default([])
  // Ограничения своими словами: то, что не покрыто ни одним готовым режимом.
  dietNotes     String?
  targetKcal    Int?
  targetProtein Int?
  targetFat     Int?
  targetCarbs   Int?
  adviceTone    AdviceTone    @default(friendly)
  adviceTime    String        @default("09:00")
  adviceEnabled Boolean       @default(true)
  updatedAt     DateTime      @updatedAt
}

enum MealSource {
  photo
  text
  manual
}

model Meal {
  id                Int        @id @default(autoincrement())
  userId            Int
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoFileId       String?
  photoThumbFileId  String? // маленький размер фото Telegram — для быстрых превью в ленте
  photoS3Key        String?
  tgMessageId       BigInt? // message_id карточки в чате — для уточнения ответом на неё
  eatenAt           DateTime   @default(now())
  totalKcal         Float      @default(0)
  totalProtein      Float      @default(0)
  totalFat          Float      @default(0)
  totalCarbs        Float      @default(0)
  aiComment         String?
  // Отметка о соответствии режиму питания на момент записи. Хранится, чтобы
  // карточка не теряла её при перерисовке после уточнения блюда.
  dietNote          String?
  dietVerdict       String? // ok | caution | avoid
  overallConfidence Float?
  source            MealSource
  items             MealItem[]

  @@index([userId, eatenAt])
}

model MealItem {
  id         Int    @id @default(autoincrement())
  mealId     Int
  meal       Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  dish       String
  grams      Float
  kcal       Float
  protein    Float
  fat        Float
  carbs      Float
  confidence Float  @default(1)
}

enum AdviceKind {
  daily
  monthly
}

model DailyAdvice {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String // локальная дата пользователя YYYY-MM-DD (для monthly — YYYY-MM-01 отчётного месяца)
  kind       AdviceKind @default(daily)
  adviceText String
  statsJson  Json
  createdAt  DateTime   @default(now())

  @@unique([userId, date, kind])
  @@index([userId, kind])
}

enum Plan {
  free
  pro
}

enum SubscriptionStatus {
  active
  expired
  canceled
}

model Subscription {
  id             Int                @id @default(autoincrement())
  userId         Int
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan
  status         SubscriptionStatus @default(active)
  startedAt      DateTime           @default(now())
  expiresAt      DateTime
  starsPaymentId String?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model UsageCounter {
  userId     Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String // локальная дата пользователя YYYY-MM-DD
  photoCount Int    @default(0)

  @@id([userId, date])
}
